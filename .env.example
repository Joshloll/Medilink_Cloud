# Supabase Configuration - TEMPLATE (DO NOT COMMIT ACTUAL VALUES)
# Copy this file to .env and fill in your actual values
# .env file is gitignored and should NEVER be committed to version control

# ============================================================================
# SUPABASE CREDENTIALS
# ============================================================================
# These are PUBLIC credentials used in the browser (anon key only)
# Do NOT store service_role_key in frontend under any circumstances

# Your Supabase project URL
# Get this from: https://app.supabase.com -> Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon (public) key
# Get this from: https://app.supabase.com -> Settings -> API -> Project API keys
# ⚠️ IMPORTANT: Only the ANON key, NEVER the service_role key
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================================
# OPTIONAL: For backend API proxy (if using one)
# ============================================================================
# Backend API URL (if you have a Node.js/Express backend)
# Leave empty if using direct Supabase connection
VITE_API_URL=http://localhost:3001

# Backend API Key (if using API authentication)
# Leave empty if not using backend authentication
VITE_API_KEY=your-backend-api-key-here

# ============================================================================
# ENVIRONMENT
# ============================================================================
# Set to development, staging, or production
NODE_ENV=development

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. ANON KEY vs SERVICE ROLE KEY:
#    - Anon Key: Safe for frontend (limited permissions via RLS)
#    - Service Role Key: SECRET - Never expose in frontend
#
# 2. ROW LEVEL SECURITY (RLS):
#    - Enables column/row access control for anon key
#    - Essential for security when using anon key
#
# 3. CORS CONFIGURATION:
#    - Configure in Supabase Settings → API → CORS
#    - Add your project URLs (localhost:3000, production-url, etc)
#
# 4. ENVIRONMENT VARIABLE NAMING:
#    - VITE_ prefix exposes variables to frontend (browser)
#    - Build tools strip VITE_ prefix and embed in client bundle
#    - Do NOT use for sensitive serverside-only data
#
# 5. DEPLOYMENT:
#    - Set env vars in your hosting platform (Vercel, Netlify, etc)
#    - Never commit .env to version control
#    - Use different credentials per environment (dev/staging/prod)
#
# ============================================================================
